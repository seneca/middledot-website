---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const scripts = await getCollection('scripts');
  return scripts.map((script) => ({
    params: { slug: script.id },
    props: { script },
  }));
}

const { script } = Astro.props;
const { Content } = await render(script);
---

<BaseLayout title={`${script.data.title} — middledot`} description={script.data.description}>
  <article>
    <section class="page-hero post-hero">
      <div class="container">
        <a href="/scripts/" class="back-link">&larr; Back to scripts</a>
        <h1>{script.data.title}</h1>
        {script.data.description && <p>{script.data.description}</p>}
        <div class="card-meta">
          {script.data.affinityVersion && (
            <span class="card-tag">{script.data.affinityVersion}</span>
          )}
          {script.data.tags.map((tag) => (
            <span class="card-tag">{tag}</span>
          ))}
        </div>
      </div>
    </section>

    {script.data.downloads && script.data.downloads.length > 0 && (
      <section class="download-bar">
        <div class="container">
          <div class="download-bar-inner">
            <span class="download-bar-label">Download Script</span>
            <div class="download-links">
              {script.data.downloads.map((dl) => (
                <a href={dl} class="btn btn-primary" download>Download</a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="post-cover section">
      <div class="container">
        <div class="post-cover-grid">
          <div class="post-cover-images">
            {script.data.images && script.data.images.length > 0 ? (
              script.data.images.map((img) => (
                <img src={img} alt="" class="post-cover-img" />
              ))
            ) : (
              <div class="post-cover-placeholder" />
            )}
          </div>
          <div class="post-cover-body">
            <div class="prose">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
  .post-hero time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-block-end: var(--space-sm);
  }

  .post-hero h1 {
    margin-block-end: var(--space-sm);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--brand);
    margin-block-end: var(--space-md);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
