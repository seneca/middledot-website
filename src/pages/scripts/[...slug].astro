---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const scripts = await getCollection('scripts');
  return scripts.map((script) => ({
    params: { slug: script.id },
    props: { script },
  }));
}

const { script } = Astro.props;
const { Content } = await render(script);
---

<BaseLayout title={`${script.data.title} — middledot`} description={script.data.description}>
  <article>
    <section class="page-hero post-hero">
      <div class="container">
        <a href="/scripts/" class="back-link">&larr; Back to scripts</a>
        <h1>{script.data.title}</h1>
        {script.data.description && <p>{script.data.description}</p>}
        <div class="card-meta">
          {script.data.affinityVersion && (
            <span class="card-tag">{script.data.affinityVersion}</span>
          )}
          {script.data.tags.map((tag) => (
            <span class="card-tag">{tag}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
  .post-hero time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-block-end: var(--space-sm);
  }

  .post-hero h1 {
    margin-block-end: var(--space-sm);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--brand);
    margin-block-end: var(--space-md);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
